<Project>

  <!-- The folders whose projects ship. Normalised like the project directory is, so the comparison holds with Windows separators too. -->
  <PropertyGroup Label="Roots">
    <_SrcRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'src'))</_SrcRoot>
    <_SamplesRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'samples'))</_SamplesRoot>
  </PropertyGroup>

  <PropertyGroup Label="Name">
    <!-- NuGet package IDs are this prefix plus the project name without its "OneGame" part. This is the only place the prefix is written. -->
    <PackagePrefix>RecursiveAI.OneGame</PackagePrefix>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <PropertyGroup Label="Output">
    <!-- Build output stays out of the source folders. Set ONEGAME_ARTIFACTS to choose where; the default is artifacts/ at the
         repository root, which .gitignore covers. -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath Condition="'$(ONEGAME_ARTIFACTS)' != ''">$(ONEGAME_ARTIFACTS)</ArtifactsPath>
    <ArtifactsPath Condition="'$(ONEGAME_ARTIFACTS)' == ''">$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

  <!-- Every shader is compiled for each graphics backend: SPIR-V for Vulkan, Metal Shading Language for Metal, WGSL for WebGPU. -->
  <PropertyGroup Label="Shader targets">
    <OneShaderTargets>SpirV;Msl;Wgsl</OneShaderTargets>
  </PropertyGroup>

  <PropertyGroup Label="Language and analysis">
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>Recursive AI, LLC</Authors>
    <Company>Recursive AI, LLC</Company>
    <Copyright>Copyright (c) Recursive AI, LLC</Copyright>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageId Condition="$(MSBuildProjectName.StartsWith('OneGame.'))">$(PackagePrefix)$(MSBuildProjectName.Substring(7))</PackageId>
    <PackageId Condition="'$(PackageId)' == ''">$(PackagePrefix).$(MSBuildProjectName)</PackageId>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/recursive-ai-oss/onegame</RepositoryUrl>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>gamedev;game-engine;nativeaot;trimmable;source-generators;deterministic</PackageTags>
    <!-- Symbols ship as .snupkg files; SourceLink comes with the SDK. The release workflow sets ContinuousIntegrationBuild for
         deterministic source paths; ordinary builds keep real paths because tests find their data files through them. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!-- The engine (libraries and the onegame command) carries the release version; samples keep their own. -->
  <PropertyGroup Condition="$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)').StartsWith('$(_SrcRoot)'))">
    <Version>1.11.0</Version>
  </PropertyGroup>

  <!-- Only the engine libraries under src/ are packages. The sample games and the tools are built, not published to nuget.org. -->
  <PropertyGroup Condition="!$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)').StartsWith('$(_SrcRoot)'))">
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <!-- "Ships" means the code goes into a player's game: everything under src/ and samples/. Those projects get the package
       guard (build/PackageGuard.targets) and the AOT and trim analyzers. Tests, tools and validation are free to use any package. -->
  <PropertyGroup Label="Shaders">
    <!-- SPIR-V for Vulkan, MSL for Metal, WGSL for WebGPU. -->
    <OneShaderTargets>SpirV;Msl;Wgsl</OneShaderTargets>
  </PropertyGroup>

  <PropertyGroup Label="Shipping code">
    <_ProjectDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)'))</_ProjectDir>
    <OneGameShips Condition="'$(OneGameShips)' == '' and ($(_ProjectDir.StartsWith('$(_SrcRoot)')) or $(_ProjectDir.StartsWith('$(_SamplesRoot)')))">true</OneGameShips>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OneGameShips)' == 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableTrimAnalyzer Condition="'$(MSBuildProjectName)' != 'OneGame.Generators'">true</EnableTrimAnalyzer>
    <EnableAotAnalyzer Condition="'$(MSBuildProjectName)' != 'OneGame.Generators'">true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer Condition="'$(MSBuildProjectName)' != 'OneGame.Generators'">true</EnableSingleFileAnalyzer>
    <IsAotCompatible Condition="'$(MSBuildProjectName)' != 'OneGame.Generators'">true</IsAotCompatible>
    <IsTrimmable Condition="'$(MSBuildProjectName)' != 'OneGame.Generators'">true</IsTrimmable>
  </PropertyGroup>

</Project>

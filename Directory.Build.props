<Project>

  <PropertyGroup Label="Name">
    <!-- NuGet package IDs are this prefix plus the project name without its "OneGame" part. This is the only place the prefix is written. -->
    <PackagePrefix>RecursiveAI.OneGame</PackagePrefix>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <PropertyGroup Label="Output">
    <!-- Build output stays out of the source folders. Set ONEGAME_ARTIFACTS to choose where; the default is artifacts/ at the
         repository root, which .gitignore covers. -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath Condition="'$(ONEGAME_ARTIFACTS)' != ''">$(ONEGAME_ARTIFACTS)</ArtifactsPath>
    <ArtifactsPath Condition="'$(ONEGAME_ARTIFACTS)' == ''">$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

  <!-- Every shader is compiled for each graphics backend: SPIR-V for Vulkan, Metal Shading Language for Metal, WGSL for WebGPU. -->
  <PropertyGroup Label="Shader targets">
    <OneShaderTargets>SpirV;Msl;Wgsl</OneShaderTargets>
  </PropertyGroup>

  <PropertyGroup Label="Language and analysis">
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>Recursive AI, LLC</Authors>
    <Company>Recursive AI, LLC</Company>
    <Copyright>Copyright (c) Recursive AI, LLC</Copyright>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageId Condition="$(MSBuildProjectName.StartsWith('OneGame.'))">$(PackagePrefix)$(MSBuildProjectName.Substring(7))</PackageId>
    <PackageId Condition="'$(PackageId)' == ''">$(PackagePrefix).$(MSBuildProjectName)</PackageId>
  </PropertyGroup>

  <!-- "Ships" means the code goes into a player's game: everything under src/ and samples/. Those projects get the package
       guard (build/PackageGuard.targets) and the AOT and trim analyzers. Tests, tools and validation are free to use any package. -->
  <PropertyGroup Label="Shaders">
    <!-- SPIR-V for Vulkan, MSL for Metal, WGSL for WebGPU. -->
    <OneShaderTargets>SpirV;Msl;Wgsl</OneShaderTargets>
  </PropertyGroup>

  <PropertyGroup Label="Shipping code">
    <_ProjectDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)'))</_ProjectDir>
    <OneGameShips Condition="'$(OneGameShips)' == '' and ($(_ProjectDir.StartsWith('$(MSBuildThisFileDirectory)src/')) or $(_ProjectDir.StartsWith('$(MSBuildThisFileDirectory)samples/')))">true</OneGameShips>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OneGameShips)' == 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableTrimAnalyzer Condition="'$(MSBuildProjectName)' != 'OneGame.Generators'">true</EnableTrimAnalyzer>
    <EnableAotAnalyzer Condition="'$(MSBuildProjectName)' != 'OneGame.Generators'">true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer Condition="'$(MSBuildProjectName)' != 'OneGame.Generators'">true</EnableSingleFileAnalyzer>
    <IsAotCompatible Condition="'$(MSBuildProjectName)' != 'OneGame.Generators'">true</IsAotCompatible>
    <IsTrimmable Condition="'$(MSBuildProjectName)' != 'OneGame.Generators'">true</IsTrimmable>
  </PropertyGroup>

</Project>

<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Build-time only: the source generator project. Never flows to a consumer (PrivateAssets="all"). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The one* family: the only packages that may ship. -->
    <PackageVersion Include="RecursiveAI.OneFont" Version="1.3.0" />
    <PackageVersion Include="RecursiveAI.OneImage" Version="1.10.1" />
    <PackageVersion Include="RecursiveAI.OneImage.Svg" Version="1.10.1" />
    <PackageVersion Include="OneYaml" Version="1.2.1" />
    <PackageVersion Include="RecursiveAI.OneAudio" Version="1.3.0" />
    <PackageVersion Include="RecursiveAI.OneAudio.Devices" Version="1.3.0" />
    <PackageVersion Include="RecursiveAI.OneShader" Version="1.3.0" />
    <PackageVersion Include="RecursiveAI.OneShader.Build" Version="1.3.0" />
    <PackageVersion Include="RecursiveAI.OneRender" Version="1.3.1" />
    <PackageVersion Include="RecursiveAI.OneHtml" Version="1.5.1" />
    <PackageVersion Include="RecursiveAI.OnePath" Version="0.1.0-preview.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test projects only. Shipping projects may depend on the one* family and nothing else. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.v3.assert" Version="4.0.2" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
    <!-- Reference renderer for comparing glyph coverage; tests only. -->
    <PackageVersion Include="RecursiveAI.OneImage.Text" Version="1.10.1" />
    <!-- The reference rasterizer and the default fonts of the page renderer's comparison tests. -->
    <PackageVersion Include="RecursiveAI.OneRender.Image" Version="1.3.1" />
    <PackageVersion Include="RecursiveAI.OneRender.Fonts" Version="1.3.1" />
  </ItemGroup>
</Project>

    <Compile Include="../OneGame.Platform.Tests/AppThread.cs" Link="Shared/AppThread.cs" />
    <Compile Include="../OneGame.Platform.Tests/MainThread.cs" Link="Shared/MainThread.cs" />
  </ItemGroup>

</Project>

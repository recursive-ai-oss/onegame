<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OneGame.Core.Fuzz</RootNamespace>
    <!-- The decoders and sample entities come from the Core test project, so the fuzzer and the regression test run the same code. -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../OneGame.Core.Tests/Samples/*.cs" LinkBase="Samples" />
    <Compile Include="../OneGame.Core.Tests/Fuzz/FuzzTargets.cs" Link="FuzzTargets.cs" />
    <Compile Include="../OneGame.Sync.Tests/Scenario.cs" Link="Sync/Scenario.cs" />
    <Compile Include="../OneGame.Sync.Tests/Arena.cs" Link="Sync/Arena.cs" />
    <Compile Include="../OneGame.Sync.Tests/Rig.cs" Link="Sync/Rig.cs" />
    <Compile Include="../OneGame.Sync.Tests/Realm.cs" Link="Sync/Realm.cs" />
    <Compile Include="../OneGame.Sync.Tests/HandoffRig.cs" Link="Sync/HandoffRig.cs" />
    <Compile Include="../OneGame.Sync.Tests/RelayRig.cs" Link="Sync/RelayRig.cs" />
    <Compile Include="../OneGame.Sync.Tests/Fuzz/SyncFuzzTargets.cs" Link="Sync/SyncFuzzTargets.cs" />
    <Compile Include="../OneGame.Net.Tests/Fuzz/NetFuzzTargets.cs" Link="Net/NetFuzzTargets.cs" />
    <Compile Include="../OneGame.Gltf.Tests/Fuzz/GltfFuzzTargets.cs" Link="Gltf/GltfFuzzTargets.cs" />
    <Compile Include="../OneGame.Purchases.Tests/Fuzz/PurchasesFuzzTargets.cs" Link="Purchases/PurchasesFuzzTargets.cs" />
    <Compile Include="../OneGame.Purchases.Tests/Fuzz/PlayMessages.cs" Link="Purchases/PlayMessages.cs" />
    <ProjectReference Include="../../src/OneGame.Purchases/OneGame.Purchases.csproj" />
    <ProjectReference Include="../../src/OneGame.Gltf/OneGame.Gltf.csproj" />
    <ProjectReference Include="../../src/OneGame.Net/OneGame.Net.csproj" />
    <ProjectReference Include="../../src/OneGame.Core/OneGame.Core.csproj" />
    <ProjectReference Include="../../src/OneGame.Sync/OneGame.Sync.csproj" />
    <ProjectReference Include="../../src/OneGame.Generators/OneGame.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real models the glTF targets mutate. -->
    <None Include="../../testdata/gltf/**" Link="testdata/gltf/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="OneGame.Core" />
    <Using Include="OneGame.Sync" />
  </ItemGroup>

</Project>

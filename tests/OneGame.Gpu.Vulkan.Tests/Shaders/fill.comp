#version 450
// Each invocation writes a value derived from its index; the test reads the buffer back.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer Out { uint data[]; } outBuf;
layout(set = 0, binding = 1) readonly buffer In { uint data[]; } inBuf;
void main() {
    uint i = gl_GlobalInvocationID.x;
    outBuf.data[i] = inBuf.data[i] * 3u + i * i + 7u;
}

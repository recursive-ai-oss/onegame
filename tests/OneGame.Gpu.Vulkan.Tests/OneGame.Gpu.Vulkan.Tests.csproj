<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The tests open their own X11 window through Xlib, which needs source-generated P/Invoke. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The texture-array fixture uses a resource array, which WebGPU's shading language cannot express. -->
    <OneShaderTargets>SpirV;Msl</OneShaderTargets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RecursiveAI.OneShader.Build" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneGame.Gpu.Backends/OneGame.Gpu.Backends.csproj" />
  </ItemGroup>

</Project>

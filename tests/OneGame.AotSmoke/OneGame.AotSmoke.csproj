<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OneGame.AotSmoke</RootNamespace>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The smoke entities go through the generator like a game's would. -->
    <ProjectReference Include="../../src/OneGame.Generators/OneGame.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every runtime assembly, so the publish trims and compiles all of them. -->
    <ProjectReference Include="../../src/OneGame.Core/OneGame.Core.csproj" />
    <ProjectReference Include="../../src/OneGame.Sync/OneGame.Sync.csproj" />
    <ProjectReference Include="../../src/OneGame.Net/OneGame.Net.csproj" />
    <ProjectReference Include="../../src/OneGame.Gpu/OneGame.Gpu.csproj" />
    <ProjectReference Include="../../src/OneGame.Gpu.Vulkan/OneGame.Gpu.Vulkan.csproj" />
    <ProjectReference Include="../../src/OneGame.Platform/OneGame.Platform.csproj" />
    <ProjectReference Include="../../src/OneGame.Render2D/OneGame.Render2D.csproj" />
    <ProjectReference Include="../../src/OneGame.UI/OneGame.UI.csproj" />
    <ProjectReference Include="../../src/OneGame.UI.Kit/OneGame.UI.Kit.csproj" />
    <ProjectReference Include="../../src/OneGame.Atlas/OneGame.Atlas.csproj" />
    <ProjectReference Include="../../src/OneGame.Text/OneGame.Text.csproj" />
    <ProjectReference Include="../../src/OneGame.Audio/OneGame.Audio.csproj" />
    <EmbeddedResource Include="../../testdata/audio/tone44k.ogg" LogicalName="tone44k.ogg" />
    <EmbeddedResource Include="../../testdata/audio/loop48k.opus" LogicalName="loop48k.opus" />
    <EmbeddedResource Include="../../testdata/audio/tone44k.flac" LogicalName="tone44k.flac" />
    <EmbeddedResource Include="../../testdata/audio/tone44k.mp3" LogicalName="tone44k.mp3" />
    <ProjectReference Include="../../src/OneGame.Gltf/OneGame.Gltf.csproj" />
    <EmbeddedResource Include="../../testdata/gltf/Fox/glTF-Binary/Fox.glb" LogicalName="fox.glb" />
    <EmbeddedResource Include="../../testdata/gltf/Box/glTF-Embedded/Box.gltf" LogicalName="box.gltf" />
    <ProjectReference Include="../../src/OneGame.Steam/OneGame.Steam.csproj" />
    <ProjectReference Include="../../src/OneGame.Control/OneGame.Control.csproj" />
    <ProjectReference Include="../../src/OneGame.Testing/OneGame.Testing.csproj" />
    <ProjectReference Include="../../src/OneGame.Host/OneGame.Host.csproj" />
    <ProjectReference Include="../../src/OneGame.Live/OneGame.Live.csproj" />
    <!-- The headless server host and its live control. The plugin loader (OneGame.Server.Plugins) is CoreCLR-only and stays out. -->
    <ProjectReference Include="../../src/OneGame.Server/OneGame.Server.csproj" />
    <ProjectReference Include="../../src/OneGame.Server.Live/OneGame.Server.Live.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The compute shader of the graph smoke is compiled during the build, like a game's shaders. -->
    <PackageReference Include="RecursiveAI.OneShader.Build" />
  </ItemGroup>

  <ItemGroup>
    <!-- A font and an icon for the text smoke. -->
    <EmbeddedResource Include="../../testdata/text/fonts/NotoSans-Subset-Regular.ttf" LogicalName="font.ttf" />
    <EmbeddedResource Include="../../testdata/text/svg/coin.svg" LogicalName="coin.svg" />
  </ItemGroup>

</Project>

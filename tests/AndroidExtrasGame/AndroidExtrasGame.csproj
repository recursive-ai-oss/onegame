<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Android text game plus what a game can declare for its package: a Java activity subclass, a manifest fragment, extra attributes and a launcher icon. -->
  <PropertyGroup>
    <OneGameRoot>$(MSBuildThisFileDirectory)../../</OneGameRoot>
    <AssemblyName>AndroidExtrasGame</AssemblyName>
    <RootNamespace>AndroidTextGame</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <AndroidOrientation>fullSensor</AndroidOrientation>
    <AndroidPackage>dev.onegame.extras</AndroidPackage>
    <AndroidManifestFragment>android/manifest-additions.xml</AndroidManifestFragment>
    <AndroidApplicationAttributes>android:largeHeap=true</AndroidApplicationAttributes>
    <AndroidActivityAttributes>android:resizeableActivity=false</AndroidActivityAttributes>
    <AndroidIcon>android/icon.svg</AndroidIcon>
    <AndroidIconBackground>#1E3A5F</AndroidIconBackground>
  </PropertyGroup>

  <Import Project="$(OneGameRoot)build/Game.targets" />

  <ItemGroup>
    <Compile Include="../AndroidTextGame/*.cs" />
    <ProjectReference Include="$(OneGameRoot)src/OneGame.UI.Kit/OneGame.UI.Kit.csproj" />
    <EmbeddedResource Include="$(OneGameRoot)assets/fonts/NotoSans-Regular.ttf" LogicalName="fonts/NotoSans-Regular.ttf" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OneGameRoot>$(MSBuildThisFileDirectory)../../</OneGameRoot>
    <AssemblyName>ParticleGame</AssemblyName>
    <RootNamespace>ParticleGame</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <Import Project="$(OneGameRoot)build/Game.targets" />

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="Sim/*.cs" />
    <!-- The model and the font travel inside the program, so it runs from any folder. -->
    <EmbeddedResource Include="$(OneGameRoot)testdata/gltf/Box/glTF-Binary/Box.glb" LogicalName="models/Box.glb" />
    <EmbeddedResource Include="$(OneGameRoot)assets/fonts/NotoSans-Regular.ttf" LogicalName="fonts/NotoSans-Regular.ttf" />
  </ItemGroup>

</Project>

<Project>

  <!-- Imported by a game's project file (see 'onegame new'). Sets up everything a game needs: the target framework, the rules that make
       an invalid game a compile error, the engine references, and, in Debug builds only, the development tools. Set OneGameRoot to the
       engine checkout before importing, or use the RecursiveAI.OneGame.Sdk package, which imports this file itself. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Games ship through NativeAOT: no reflection-based serialization. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- A NativeAOT publish: dotnet publish -c Release -r <rid> -p:OneGameAot=true. (PublishAot itself is set here rather than on the command
         line so it does not reach the generator project, which is not an AOT target.) -->
    <PublishAot Condition="'$(OneGameAot)' == 'true'">true</PublishAot>
    <!-- The same for the self-contained CoreCLR export (onegame export when NativeAOT is not possible on this OS). -->
    <PublishTrimmed Condition="'$(OneGameTrim)' == 'true'">true</PublishTrimmed>
    <PublishReadyToRun Condition="'$(OneGameTrim)' == 'true'">true</PublishReadyToRun>
  </PropertyGroup>

  <!-- Development tools (live control over MCP, scenarios, capture, replay) are part of Debug builds. A Release build leaves them out of
       the program entirely: the project is not referenced and the start-up hook is not compiled. Override with -p:OneGameDev=true|false. -->
  <PropertyGroup>
    <OneGameDev Condition="'$(OneGameDev)' == '' and '$(Configuration)' == 'Debug'">true</OneGameDev>
    <OneGameDev Condition="'$(OneGameDev)' == ''">false</OneGameDev>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OneGameDev)' == 'true'">
    <DefineConstants>$(DefineConstants);ONEGAME_DEV</DefineConstants>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)Android.targets" />
  <Import Project="$(MSBuildThisFileDirectory)iOS.targets" />

  <!-- With OneGameRoot set (a game inside an engine checkout) the engine comes from its projects. Without it (a game on the
       RecursiveAI.OneGame.Sdk package) the same libraries come from nuget.org at the SDK's version. The generator and analyzers
       travel inside the Core package. -->
  <Target Name="OneGameCheckEngineSource" BeforeTargets="CollectPackageReferences;ResolveProjectReferences" Condition="'$(OneGameRoot)' == '' and '$(OneGameVersion)' == ''">
    <Error Code="OGBUILD002" Text="Neither OneGameRoot (an engine checkout) nor OneGameVersion (set by the RecursiveAI.OneGame.Sdk package) is set. Create the game with 'onegame new', which writes a project on the SDK." />
  </Target>

  <ItemGroup Condition="'$(OneGameRoot)' != ''">
    <ProjectReference Include="$(OneGameRoot)/src/OneGame.Host/OneGame.Host.csproj" />
    <ProjectReference Include="$(OneGameRoot)/src/OneGame.Core/OneGame.Core.csproj" />
    <ProjectReference Include="$(OneGameRoot)/src/OneGame.UI/OneGame.UI.csproj" />
    <!-- The generator and analyzers: entity code, and the rules for simulation and view code. -->
    <ProjectReference Include="$(OneGameRoot)/src/OneGame.Generators/OneGame.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- With central package management (ManagePackageVersionsCentrally in the game's Directory.Packages.props) a PackageReference may not
       carry a Version (NU1008), so the engine versions go in as VersionOverride, which wins over any PackageVersion the game lists. -->
  <ItemGroup Condition="'$(OneGameRoot)' == '' and '$(OneGameVersion)' != ''">
    <_OneGamePackage Include="RecursiveAI.OneGame.Host;RecursiveAI.OneGame.Core;RecursiveAI.OneGame.UI" />
    <_OneGamePackage Include="RecursiveAI.OneGame.Audio" Condition="'$(OneGameAudio)' != 'false'" />
    <_OneGamePackage Include="RecursiveAI.OneGame.Live" Condition="'$(OneGameDev)' == 'true'" />
  </ItemGroup>

  <!-- Sound is part of a game, so a game gets the audio service through the same reference chain as everything else and an export builds without the game naming it.
       A game that plays no sound can leave it out with -p:OneGameAudio=false (an unused library is trimmed from a NativeAOT build either way). -->
  <ItemGroup Condition="'$(OneGameAudio)' != 'false' and '$(OneGameRoot)' != ''">
    <ProjectReference Include="$(OneGameRoot)/src/OneGame.Audio/OneGame.Audio.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(OneGameDev)' == 'true' and '$(OneGameRoot)' != ''">
    <ProjectReference Include="$(OneGameRoot)/src/OneGame.Live/OneGame.Live.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'@(_OneGamePackage)' != '' and '$(ManagePackageVersionsCentrally)' != 'true'">
    <PackageReference Include="@(_OneGamePackage)" Version="$(OneGameVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'@(_OneGamePackage)' != '' and '$(ManagePackageVersionsCentrally)' == 'true'">
    <PackageReference Include="@(_OneGamePackage)" VersionOverride="$(OneGameVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(OneGameDev)' == 'true'">
    <!-- A shared library (Android) has no application code to run a module initializer from, and an iOS app starts its game late; AndroidEntry.cs and IosEntry.cs enable the tools themselves. -->
    <Compile Include="$(MSBuildThisFileDirectory)DevBoot.cs" Visible="false" Condition="'$(OneGameAndroid)' != 'true' and '$(OneGameIos)' != 'true'" />
  </ItemGroup>

</Project>

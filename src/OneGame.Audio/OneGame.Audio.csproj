<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Audio device output and the audio service that drives a mixer.</Description>
    <!-- The device backends call the operating system's audio libraries through source-generated, blittable P/Invokes; unsafe code stays inside this assembly. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RecursiveAI.OneAudio" />
    <PackageReference Include="RecursiveAI.OneAudio.Devices" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OneGame.Audio.Tests" />
  </ItemGroup>

</Project>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OneGame.Platform.Tests" />
    <InternalsVisibleTo Include="OneGame.Windowed.Tests" />
  </ItemGroup>

</Project>

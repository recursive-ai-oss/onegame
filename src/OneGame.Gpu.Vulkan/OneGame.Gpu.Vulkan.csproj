<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Vulkan backend of the graphics layer.</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The one place native interop lives for graphics: blittable structs and function pointers into the Vulkan loader. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OneGame.Gpu/OneGame.Gpu.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OneGame.Gpu.Vulkan.Tests" />
  </ItemGroup>

</Project>

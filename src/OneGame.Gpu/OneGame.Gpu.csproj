<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Render graph over the GPU layer (RecursiveAI.OneGpu).</Description>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Devices, buffers, textures, pipelines and encoders. The backends are chosen by the host or the test, not here. -->
    <PackageReference Include="RecursiveAI.OneGpu" />
  </ItemGroup>

  <ItemGroup>
    <!-- The graph is written against the GPU layer's types, which used to share its namespace. -->
    <Using Include="RecursiveAI.OneGpu" />
  </ItemGroup>

</Project>

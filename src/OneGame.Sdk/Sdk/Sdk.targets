<Project>

  <!-- A game project is a game unless it says <OneGameKind>Server</OneGameKind> (a dedicated server) or Plugin (a server plugin library). -->
  <PropertyGroup>
    <OneGameKind Condition="'$(OneGameKind)' == ''">Game</OneGameKind>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)../targets/Game.targets" Condition="'$(OneGameKind)' != 'Server' and '$(OneGameKind)' != 'Plugin'" />
  <Import Project="$(MSBuildThisFileDirectory)../targets/Server.targets" Condition="'$(OneGameKind)' == 'Server' or '$(OneGameKind)' == 'Plugin'" />

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Loads server plugins into collectible load contexts. CoreCLR only: it uses reflection and assembly loading, so NativeAOT hosts leave it out.</Description>
    <!-- This is the one place runtime reflection is allowed. Nothing NativeAOT-published references this project. -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OneGame.Server/OneGame.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <InternalsVisibleTo Include="OneGame.Server.Tests" />
  </ItemGroup>

</Project>

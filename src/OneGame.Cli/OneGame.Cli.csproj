<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>onegame</AssemblyName>
    <RootNamespace>OneGame.Cli</RootNamespace>
    <!-- Published NativeAOT for the repository's own scripts; packed as a framework-dependent dotnet tool
         (dotnet tool install RecursiveAI.OneGame.Cli), because a tool package carries no native binary. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>onegame</ToolCommandName>
    <PackageId>RecursiveAI.OneGame.Cli</PackageId>
    <PublishAot Condition="'$(_IsPacking)' != 'true'">true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <Description>The onegame command: create, build, run, test, capture and replay games.</Description>
    <!-- No reflection-based JSON: all serialization goes through the source-generated context. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OneGame.Control/OneGame.Control.csproj" />
    <ProjectReference Include="../OneGame.Gltf/OneGame.Gltf.csproj" />
    <ProjectReference Include="../OneGame.Host/OneGame.Host.csproj" />
    <ProjectReference Include="../OneGame.Render3D/OneGame.Render3D.csproj" />
    <ProjectReference Include="../OneGame.Testing/OneGame.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Where this build of the tool came from, so 'onegame new' can find the engine sources when it is not run from inside them. The installed tool package carries none: a game it creates uses the SDK package. -->
    <AssemblyMetadata Include="OneGameRoot" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))" Condition="'$(ContinuousIntegrationBuild)' != 'true' and '$(_IsPacking)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- The licence notices every export carries; the repository file is the single source. -->
    <EmbeddedResource Include="../../THIRD-PARTY-NOTICES.md" LogicalName="THIRD-PARTY-NOTICES.md" />
    <!-- The font a new game starts with, and its licence. -->
    <EmbeddedResource Include="../../assets/fonts/NotoSans-Regular.ttf" LogicalName="fonts/NotoSans-Regular.ttf" />
    <EmbeddedResource Include="../../assets/fonts/OFL.txt" LogicalName="fonts/OFL.txt" />
    <!-- What a new game starts with: a ship picture, and the reference frame its look scenario compares against. -->
    <EmbeddedResource Include="../../assets/templates/ship.png" LogicalName="template/art/ship.png" />
    <EmbeddedResource Include="../../assets/templates/ship-reference.png" LogicalName="template/ship-reference.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- The browser page and script modules a web export serves beside the runtime; the files next to the code that uses them are the single source. -->
    <EmbeddedResource Include="../../tools/web/page/index.html" LogicalName="web/index.html" />
    <EmbeddedResource Include="../../tools/web/page/boot.mjs" LogicalName="web/boot.mjs" />
    <EmbeddedResource Include="../OneGame.Gpu.WebGpu/js/onegame-gpu.js" LogicalName="web/onegame-gpu.js" />
    <EmbeddedResource Include="../OneGame.Platform/js/onegame-platform.js" LogicalName="web/onegame-platform.js" />
    <EmbeddedResource Include="../OneGame.Audio/js/onegame-audio.js" LogicalName="web/onegame-audio.js" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OneGame.Cli.Tests" />
  </ItemGroup>

</Project>

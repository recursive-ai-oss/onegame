<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>onegame</AssemblyName>
    <RootNamespace>OneGame.Cli</RootNamespace>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <Description>The onegame command: create, build, run, test, capture and replay games.</Description>
    <!-- No reflection-based JSON: all serialization goes through the source-generated context. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OneGame.Control/OneGame.Control.csproj" />
    <ProjectReference Include="../OneGame.Host/OneGame.Host.csproj" />
    <ProjectReference Include="../OneGame.Testing/OneGame.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Where this build of the tool came from, so 'onegame new' can find the engine sources when it is not run from inside them. -->
    <AssemblyMetadata Include="OneGameRoot" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))" />
  </ItemGroup>

  <ItemGroup>
    <!-- The licence notices every export carries; the repository file is the single source. -->
    <EmbeddedResource Include="../../THIRD-PARTY-NOTICES.md" LogicalName="THIRD-PARTY-NOTICES.md" />
    <!-- The font a new game starts with, and its licence. -->
    <EmbeddedResource Include="../../assets/fonts/NotoSans-Regular.ttf" LogicalName="fonts/NotoSans-Regular.ttf" />
    <EmbeddedResource Include="../../assets/fonts/OFL.txt" LogicalName="fonts/OFL.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OneGame.Cli.Tests" />
  </ItemGroup>

</Project>
